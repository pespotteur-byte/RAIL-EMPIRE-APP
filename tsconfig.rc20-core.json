{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "files": [
    "src/ts/scheduled-incident-stop.ts",
    "src/ts/duplicate-tools.ts",
    "src/ts/livery-model.ts",
    "src/ts/livery-canvas.ts",
    "src/ts/livery-editor.ts"
  ]
}