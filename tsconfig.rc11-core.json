{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "lib": [
      "ES2022"
    ],
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "files": [
    "src/ts/material-track-location.ts",
    "src/ts/formation-turnback.ts",
    "src/ts/physics-profile-stream.ts",
    "src/ts/html-text.ts"
  ]
}
