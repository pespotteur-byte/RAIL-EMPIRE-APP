{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "lib": [
      "ES2022"
    ],
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
