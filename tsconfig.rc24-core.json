{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "files": [
    "src/ts/rame-random.ts",
    "src/ts/windowed-list.ts",
    "src/ts/operations-view-model.ts",
    "src/ts/qg-page.ts",
    "src/ts/infogare-re.ts",
    "src/ts/legacy-board-plan.ts"
  ]
}
